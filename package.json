{
  "name": "@flyer103/dsh-side-chat",
  "version": "0.3.1",
  "description": "DSH side chat: fork the current session into an ephemeral side conversation that can really edit files, without polluting the main transcript.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "side-chat",
    "side-conversation",
    "context-isolation"
  ],
  "license": "MIT",
  "author": {
    "name": "flyer103",
    "email": "flyer103@gmail.com",
    "url": "https://github.com/flyer103"
  },
  "homepage": "https://github.com/flyer103/dsh-side-chat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyer103/dsh-side-chat.git"
  },
  "engines": {
    "node": ">=22"
  }
}
